{
  "name": "@systembook/schema",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Contratos de tipo compartilhados do SystemBook — PreviewConfig, tipos de bloco e mensagens de preview.",
  "keywords": ["systembook", "design-system", "documentation", "types"],
  "homepage": "https://github.com/mateusvillain/systembook#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mateusvillain/systembook.git",
    "directory": "packages/schema"
  },
  "bugs": "https://github.com/mateusvillain/systembook/issues",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
