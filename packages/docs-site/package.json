{
  "name": "@systembook/docs-site",
  "version": "0.2.0",
  "license": "MIT",
  "description": "Documentação pública do SystemBook e renderização de conteúdo, independentes da fonte de dados (CMS ou arquivos estáticos).",
  "keywords": [
    "systembook",
    "design-system",
    "documentation",
    "react",
    "tiptap"
  ],
  "homepage": "https://github.com/mateusvillain/systembook#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mateusvillain/systembook.git",
    "directory": "packages/docs-site"
  },
  "bugs": "https://github.com/mateusvillain/systembook/issues",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./content.css": "./src/content/content.css",
    "./public.css": "./src/public/public.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "scripts": {
    "prepack": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-switch": "^1.3.4",
    "@systembook/schema": "workspace:^",
    "@tiptap/core": "^3.28.0",
    "@tiptap/extension-bold": "^3.28.0",
    "@tiptap/extension-code-block": "^3.28.0",
    "@tiptap/extension-code-block-lowlight": "^3.28.0",
    "@tiptap/extension-document": "^3.28.0",
    "@tiptap/extension-heading": "^3.28.0",
    "@tiptap/extension-italic": "^3.28.0",
    "@tiptap/extension-link": "^3.28.0",
    "@tiptap/extension-list": "^3.28.0",
    "@tiptap/extension-paragraph": "^3.28.0",
    "@tiptap/extension-table": "^3.28.0",
    "@tiptap/extension-text": "^3.28.0",
    "@tiptap/extension-underline": "3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.25.0",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.101.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.2",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.1",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./content.css": "./dist/content/content.css",
      "./public.css": "./dist/public/public.css"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
