{
  "name": "@systembook/cli",
  "version": "0.2.0",
  "license": "MIT",
  "description": "CLI do SystemBook: previews de componentes (os dois modos) e o build do site estático a partir de arquivos .md/.mdx.",
  "keywords": [
    "systembook",
    "design-system",
    "documentation",
    "static-site",
    "cli"
  ],
  "homepage": "https://github.com/mateusvillain/systembook#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mateusvillain/systembook.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/mateusvillain/systembook/issues",
  "type": "module",
  "types": "./src/index.ts",
  "bin": {
    "systembook": "./bin/systembook.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "app",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "scripts": {
    "prepack": "tsc -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src app",
    "typecheck": "tsc --noEmit && tsc --noEmit -p app",
    "test": "vitest run",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@systembook/connector": "workspace:^",
    "@systembook/content": "workspace:^",
    "@systembook/docs-site": "workspace:^",
    "@systembook/schema": "workspace:^",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.2",
    "@vitejs/plugin-react": "^4.7.0",
    "commander": "^14.0.0",
    "esbuild": "^0.25.0",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
      "systembook": "./dist/cli.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
