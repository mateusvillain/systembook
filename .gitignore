!packages/connector/fixtures/**/node_modules/

# Builds
dist/
*.tsbuildinfo

# Banco local (SQLite)
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Segredos — NUNCA commitar
.env
.env.local
.env.*.local

# Logs e temporários
*.log
.DS_Store

# Store do pnpm criado pelo container de dev
.pnpm-store/

# Entradas sintéticas e artefato dos previews (systembook previews generate/build)
.systembook/

# Tarballs gerados por `pnpm pack` antes de publicar no npm
.publish/

# PRD, backlog e memória do agente — vivem só localmente (PRDs novos ficam no Linear)
.prd/

# Saída padrão do systembook build (modo estático)
systembook-dist/

# Projetos temporários dos testes do CLI
packages/cli/.tmp/
