{
  "acme": {
    "brand": {
      "$type": "color",
      "$value": "{acme.primary}",
      "$deprecated": "Use acme.primary — brand era o nome da primeira versão."
    },
    "palette": {
      "$type": "color",
      "$description": "Cores primitivas. Os tokens de papel (light.json e dark.json) apontam para elas.",
      "white": { "$value": "#ffffff" },
      "indigo": {
        "300": { "$value": "#a5b4fc" },
        "400": { "$value": "#818cf8" },
        "500": { "$value": "#6366f1" },
        "600": { "$value": "#4f46e5" },
        "700": { "$value": "#4338ca" }
      },
      "slate": {
        "50": { "$value": "#f8fafc" },
        "100": { "$value": "#f1f5f9" },
        "200": { "$value": "#e2e8f0" },
        "400": { "$value": "#94a3b8" },
        "600": { "$value": "#475569" },
        "700": { "$value": "#334155" },
        "800": { "$value": "#1e293b" },
        "900": { "$value": "#0f172a" },
        "950": { "$value": "#020617" }
      },
      "green": {
        "400": { "$value": "#4ade80" },
        "600": { "$value": "#16a34a" }
      },
      "amber": {
        "400": { "$value": "#fbbf24" },
        "600": { "$value": "#d97706" }
      },
      "red": {
        "400": { "$value": "#f87171" },
        "600": { "$value": "#dc2626" }
      }
    },
    "space": {
      "$type": "dimension",
      "$description": "Escala de espaçamento, múltiplos de 4px.",
      "1": { "$value": "4px" },
      "2": { "$value": "8px" },
      "3": { "$value": "12px" },
      "4": { "$value": "16px" },
      "6": { "$value": "24px" },
      "8": { "$value": "32px" }
    },
    "radius": {
      "$type": "dimension",
      "sm": { "$value": "4px" },
      "md": { "$value": "8px" },
      "lg": { "$value": "12px" },
      "full": { "$value": "9999px", "$description": "Pílulas e avatares." }
    },
    "border": {
      "width": {
        "$type": "dimension",
        "$description": "Espessura de bordas e divisores.",
        "thin": { "$value": "1px", "$description": "Divisores e campos em repouso." },
        "medium": { "$value": "2px", "$description": "Anel de foco e campo selecionado." },
        "thick": { "$value": "4px", "$description": "Indicador de aba ativa." }
      }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "sans": { "$value": ["Inter", "system-ui", "sans-serif"], "$description": "Interface e texto corrido." },
        "serif": { "$value": ["Georgia", "Times New Roman", "serif"], "$description": "Citações e conteúdo editorial longo." },
        "mono": { "$value": ["JetBrains Mono", "ui-monospace", "monospace"], "$description": "Código, tokens e valores tabulares." }
      },
      "weight": {
        "$type": "fontWeight",
        "regular": { "$value": 400, "$description": "Texto corrido." },
        "medium": { "$value": 500, "$description": "Rótulos de botão e de campo." },
        "semibold": { "$value": 600, "$description": "Títulos." },
        "bold": { "$value": 700, "$description": "Display e números de destaque." }
      }
    },
    "type": {
      "$type": "typography",
      "body": {
        "$value": {
          "fontFamily": "{acme.font.family.sans}",
          "fontSize": "16px",
          "fontWeight": "{acme.font.weight.regular}",
          "letterSpacing": "0px",
          "lineHeight": 1.5
        }
      },
      "heading": {
        "$value": {
          "fontFamily": "{acme.font.family.sans}",
          "fontSize": "24px",
          "fontWeight": "{acme.font.weight.semibold}",
          "letterSpacing": "-0.5px",
          "lineHeight": 1.25
        }
      }
    },
    "elevation": {
      "$type": "shadow",
      "$description": "Duas camadas por nível: a sombra de contato (key) e a difusa (ambient). As cores mudam com o modo.",
      "1": {
        "$description": "Cartões e campos em repouso.",
        "$value": [
          { "color": "{acme.elevation.color.key}", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
          { "color": "{acme.elevation.color.ambient}", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" }
        ]
      },
      "2": {
        "$description": "Cartão em hover e menus.",
        "$value": [
          { "color": "{acme.elevation.color.key}", "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "-1px" },
          { "color": "{acme.elevation.color.ambient}", "offsetX": "0px", "offsetY": "4px", "blur": "8px", "spread": "0px" }
        ]
      },
      "3": {
        "$description": "Popovers e dropdowns.",
        "$value": [
          { "color": "{acme.elevation.color.key}", "offsetX": "0px", "offsetY": "4px", "blur": "8px", "spread": "-2px" },
          { "color": "{acme.elevation.color.ambient}", "offsetX": "0px", "offsetY": "12px", "blur": "24px", "spread": "-4px" }
        ]
      },
      "4": {
        "$description": "Modais e diálogos.",
        "$value": [
          { "color": "{acme.elevation.color.key}", "offsetX": "0px", "offsetY": "8px", "blur": "16px", "spread": "-4px" },
          { "color": "{acme.elevation.color.ambient}", "offsetX": "0px", "offsetY": "24px", "blur": "48px", "spread": "-8px" }
        ]
      }
    },
    "shadow": {
      "$type": "shadow",
      "card": { "$value": "{acme.elevation.1}", "$description": "Alias de acme.elevation.1." }
    },
    "opacity": {
      "$type": "number",
      "hover": { "$value": 0.08, "$description": "Camada de estado sobre a cor do componente no hover." },
      "pressed": { "$value": 0.16, "$description": "Camada de estado ao pressionar." },
      "disabled": { "$value": 0.5, "$description": "Componentes desabilitados." },
      "overlay": { "$value": 0.64, "$description": "Fundo atrás de modais." }
    },
    "z-index": {
      "$type": "number",
      "$description": "Ordem de empilhamento das camadas da interface.",
      "base": { "$value": 0, "$description": "Conteúdo da página." },
      "dropdown": { "$value": 1000, "$description": "Menus e listas suspensas." },
      "sticky": { "$value": 1100, "$description": "Cabeçalhos e barras fixas." },
      "overlay": { "$value": 1300, "$description": "Fundo escurecido atrás de modais." },
      "modal": { "$value": 1400, "$description": "Modais e diálogos." },
      "toast": { "$value": 1500, "$description": "Notificações, sempre por cima." }
    },
    "motion": {
      "duration": {
        "$type": "duration",
        "fast": { "$value": "120ms", "$description": "Hover, foco, troca de cor." },
        "base": { "$value": "200ms", "$description": "Menus, tooltips, expandir e recolher." },
        "slow": { "$value": "320ms", "$description": "Modais e painéis que entram na tela." }
      },
      "easing": {
        "$type": "cubicBezier",
        "standard": { "$value": [0.2, 0, 0, 1], "$description": "Movimento dentro da tela." },
        "decelerate": { "$value": [0, 0, 0, 1], "$description": "Elementos que entram: chegam rápido e assentam." },
        "accelerate": { "$value": [0.3, 0, 1, 1], "$description": "Elementos que saem: ganham velocidade até sumir." },
        "emphasized": { "$value": [0.3, 0, 0, 1.3], "$description": "Passa do ponto e volta: só para chamar atenção." }
      },
      "transition": {
        "$type": "transition",
        "enter": {
          "$value": { "duration": "{acme.motion.duration.slow}", "delay": "0ms", "timingFunction": "{acme.motion.easing.decelerate}" },
          "$description": "Modal ou painel entrando."
        },
        "exit": {
          "$value": { "duration": "{acme.motion.duration.base}", "delay": "0ms", "timingFunction": "{acme.motion.easing.accelerate}" },
          "$description": "Saída mais curta que a entrada."
        },
        "toast": {
          "$value": { "duration": "{acme.motion.duration.base}", "delay": "120ms", "timingFunction": "{acme.motion.easing.emphasized}" },
          "$description": "Notificação, com atraso para não competir com a ação que a disparou."
        }
      }
    }
  }
}
